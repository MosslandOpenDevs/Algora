# ===========================================
# Algora Environment Configuration
# ===========================================

# Server Configuration
PORT=3201
NODE_ENV=development

# Database
DATABASE_PATH=./data/algora.db

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3200

# Public site origin used for canonical URLs, Open Graph, robots & sitemap.
# IMPORTANT: NEXT_PUBLIC_* vars are inlined at BUILD time, not pm2 runtime —
# it must be present during `next build`. Defaults to https://algora.moss.land.
NEXT_PUBLIC_SITE_URL=https://algora.moss.land

# ===========================================
# Budget Configuration (per provider)
# ===========================================
# Anthropic Claude budget
ANTHROPIC_DAILY_BUDGET_USD=10
ANTHROPIC_HOURLY_LIMIT=100

# OpenAI GPT budget
OPENAI_DAILY_BUDGET_USD=10
OPENAI_HOURLY_LIMIT=100

# Google Gemini budget
GOOGLE_DAILY_BUDGET_USD=5
GOOGLE_HOURLY_LIMIT=50

# Ollama (local, free) hourly limit
OLLAMA_HOURLY_LIMIT=1000

# Tier 2 scheduled run hours (comma-separated, 24h format)
TIER2_SCHEDULED_HOURS=6,12,18,23

# Auto-dismiss open issues untouched for this many days (in-progress issues
# get 3x this horizon; explicit 0 disables; empty/invalid falls back to 7)
ISSUE_AUTO_EXPIRE_DAYS=7

# ===========================================
# Admin Configuration
# ===========================================
# API key for admin/operational write endpoints. Sent as `x-admin-key` or
# `Authorization: Bearer <key>`. Required for privileged routes: collector
# source management, signal/issue injection, agora orchestration, treasury
# allocate/approve/disburse, snapshots, pipeline triggers, RAG indexing,
# disclosure publishing, alert deletion, KPI/cache/thermal controls. If unset,
# those routes return 503 (staying closed to the public internet). Public
# interactive endpoints (wallet verify, vote, agent summon/dismiss, agora
# session create/message, alert acknowledge) are rate-limited instead and do
# NOT require this key. Generate a secure random key: openssl rand -hex 32
ADMIN_API_KEY=

# ===========================================
# Local LLM Configuration (Tier 1) — primary
# ===========================================
LOCAL_LLM_ENDPOINT=http://localhost:11434
LOCAL_LLM_MODEL=gemma3:4b
# All tiers consolidated to gemma3:4b to keep a single model resident on a
# shared GPU. Override individually if running on hardware with more VRAM.
LOCAL_LLM_MODEL_FAST=gemma3:4b
LOCAL_LLM_MODEL_BALANCED=gemma3:4b
LOCAL_LLM_MODEL_QUALITY=gemma3:4b
# Context window (num_ctx) requested per Ollama call. Ollama's own default is
# tiny (~2048) and it SILENTLY truncates longer prompts.
#
# 16384 is a COORDINATION value, not a capacity requirement — our largest real
# prompt is ~4.5k tokens, so 8192 would suffice on headroom alone. The Ollama
# host is shared with MOSS.AO and serves ONE model instance at a time: a call
# at any num_ctx other than the resident one forces a full unload/reload
# (measured 4.3-4.5s). Both services request 16384 so neither pays that.
# If you run Algora against a host you do not share, any value >= 8192 is fine.
LOCAL_LLM_NUM_CTX=16384

# Ollama reliability tuning
LLM_TIER1_TIMEOUT_MS=180000        # 3 minute per-call timeout
LLM_TIER1_MAX_ATTEMPTS=3           # transient failures retry with backoff
LLM_TIER1_RETRY_BACKOFF_MS=3000

# ===========================================
# Tier 2 (paid APIs)
# ===========================================
# Set to true to disable all paid API calls — every LLM request will be served
# locally by Ollama. Recommended default for cost control.
LLM_DISABLE_TIER2=true

# Optional Tier 2 keys — only consulted when LLM_DISABLE_TIER2=false.
# These belong in apps/api/.env on the server (the API loads dotenv from its
# own cwd); do NOT set them in ecosystem.config.cjs, whose env block is applied
# last and would shadow them — dotenv never overwrites an already-defined var,
# and an empty string counts as defined.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Tier 2 model ids. Defaults track current models; pin a dated id for
# reproducibility. The previously hard-coded claude-3-haiku-20240307 retired
# 2026-04-19, which is why these are configurable.
# OPENAI_MODEL=gpt-5.4-mini
# ANTHROPIC_MODEL=claude-haiku-4-5
# GOOGLE_AI_MODEL=gemini-2.5-flash

# Which tier runs Agora's synthesis calls — final summary, decision packet and
# action-item extraction, i.e. the "serious deliberation" work the 3-tier design
# assigns to Tier 2. Agent chatter always stays on Tier 1 regardless. Set to 2
# only together with a provider key; a Tier-2 call degrades to Ollama if the
# tier is off, the key is bad or the budget is spent.
# AGORA_SYNTHESIS_TIER=1

# Per-token prices used by the daily budget guard, in USD per token. Both input
# and output are now billed (deliberation runs ~7:1 input:output, so pricing
# output alone under-measured spend several-fold). Unset defaults assume a
# full-size model, which over-charges a mini model and trips the guard early —
# set the real published rate for whatever OPENAI_MODEL you configure.
# OPENAI_DAILY_BUDGET_USD=10
# OPENAI_INPUT_TOKEN_PRICE=0.000003
# OPENAI_OUTPUT_TOKEN_PRICE=0.000015

# ===========================================
# External Services
# ===========================================
# Reality Oracle - Data Collection
RSS_FEEDS=https://example.com/feed1,https://example.com/feed2
SOCIAL_API_KEYS=

# Blockchain Integration (MOC)
# Set BOTH or NEITHER. With neither, token balances are fabricated for local
# development and must never be treated as voting power; with only one set the
# API refuses to start rather than reporting numbers nobody can tell apart from
# a chain read. MOC_RPC_URL / RPC_URL are accepted as aliases for the first.
ETHEREUM_RPC_URL=
MOC_TOKEN_ADDRESS=
CHAIN_ID=1

# ===========================================
# Signal Collector API Keys (Optional)
# ===========================================
# GitHub API (for higher rate limits)
GITHUB_TOKEN=your_github_token_here

# CoinMarketCap (https://coinmarketcap.com/api/)
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Etherscan (https://etherscan.io/apis)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# OpenSea NFT API (https://docs.opensea.io/reference/api-keys)
OPENSEA_API_KEY=your_opensea_api_key_here

# ===========================================
# Feature Flags
# ===========================================
ENABLE_AGENT_CHATTER=true
ENABLE_REALITY_ORACLE=true
ENABLE_PROOF_OF_OUTCOME=false

# ===========================================
# Auto-Deploy (production server only)
# ===========================================
# Opt-in gate for the pull-based deploy poller (scripts/deploy.sh). Set to 1
# ONLY on the production box: any checkout with this flag starts
# fast-forwarding itself to origin/main via pm2 cron. See ecosystem.config.cjs.
ALGORA_AUTO_DEPLOY=0
